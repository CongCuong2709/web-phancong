// ----- Navigation -----
function navigateTo(view) {
  currentView = view;
  document.querySelectorAll('.view').forEach(v => v.classList.add('hidden'));
  document.getElementById(`view-${view}`).classList.remove('hidden');

  document.querySelectorAll('[data-nav]').forEach(btn => btn.classList.remove('active'));
  const activeBtn = document.querySelector(`[data-nav="${view}"]`);
  if (activeBtn) activeBtn.classList.add('active');

  if (view === 'dashboard') renderDashboard();
  else if (view === 'projects') renderProjects();
  else if (view === 'myTasks') renderMyTasks();
  else if (view === 'reports') renderReports();

  lucide.createIcons();
}

// ===== Render: Dashboard =====
function renderDashboard() {
  const myProjects = getVisibleProjects();
  const total = myProjects.length;
  const inProgress = myProjects.filter(p => p.status === 'in_progress').length;
  const completed = myProjects.filter(p => p.status === 'completed').length;
  const overdue = myProjects.filter(p => isOverdue(p)).length;

  document.getElementById('statTotal').textContent = total;
  document.getElementById('statInProgress').textContent = inProgress;
  document.getElementById('statCompleted').textContent = completed;
  document.getElementById('statOverdue').textContent = overdue;

  // Recent (top 5 in progress or newest)
  const recent = [...myProjects]
    .sort((a, b) => new Date(b.endDate || 0) - new Date(a.endDate || 0))
    .slice(0, 5);
  const recentEl = document.getElementById('recentProjects');
  if (!recent.length) {
    recentEl.innerHTML = `<div class="p-8 text-center text-slate-400"><p>Chưa có dự án nào</p></div>`;
  } else {
    recentEl.innerHTML = recent.map(p => projectRowHtml(p)).join('');
  }

  // By department stats
  const deptMap = {};
  myProjects.forEach(p => {
    if (!deptMap[p.department]) deptMap[p.department] = { total: 0, completed: 0, inProgress: 0 };
    deptMap[p.department].total++;
    if (p.status === 'completed') deptMap[p.department].completed++;
    if (p.status === 'in_progress') deptMap[p.department].inProgress++;
  });
  const deptEl = document.getElementById('deptStats');
  const deptEntries = Object.entries(deptMap);
  if (!deptEntries.length) {
    deptEl.innerHTML = `<p class="text-sm text-slate-400 text-center py-4">Không có dữ liệu</p>`;
  } else {
    deptEl.innerHTML = deptEntries.map(([dept, s]) => {
      const pct = Math.round((s.completed / s.total) * 100);
      return `
        <div>
          <div class="flex justify-between text-sm mb-1.5">
            <span class="font-medium text-slate-700">${escapeHtml(dept)}</span>
            <span class="text-slate-500">${s.completed}/${s.total} hoàn thành</span>
          </div>
          <div class="progress-bar">
            <div class="progress-fill" style="width:${pct}%; background:${progressColor(pct)}"></div>
          </div>
        </div>`;
    }).join('');
  }
}

// ===== Visible projects (by role) =====
function getVisibleProjects() {
  if (currentUser.role === 'employee') {
    return projects.filter(p => p.assignee === currentUser.name);
  }
  return projects;
}

// ===== Filter UI =====
function populateDeptFilter() {
  const sel = document.getElementById('filterDept');
  if (!sel) return;
  const depts = Array.from(new Set(projects.map(p => p.department))).sort();
  sel.innerHTML = '<option value="">Tất cả phòng ban</option>' +
    depts.map(d => `<option value="${escapeHtml(d)}">${escapeHtml(d)}</option>`).join('');
}

// ===== Render: Projects =====
function renderProjects() {
  populateDeptFilter();
  const search = (document.getElementById('filterSearch')?.value || '').toLowerCase();
  const dept = document.getElementById('filterDept')?.value || '';
  const status = document.getElementById('filterStatus')?.value || '';
  const priority = document.getElementById('filterPriority')?.value || '';

  let list = getVisibleProjects();
  if (dept) list = list.filter(p => p.department === dept);
  if (status) list = list.filter(p => p.status === status);
  if (priority) list = list.filter(p => p.priority === priority);
  if (search) {
    list = list.filter(p =>
      (p.code || '').toLowerCase().includes(search) ||
      (p.name || '').toLowerCase().includes(search) ||
      (p.assignee || '').toLowerCase().includes(search) ||
      (p.description || '').toLowerCase().includes(search)
    );
  }

  const tbody = document.getElementById('projectTableBody');
  const empty = document.getElementById('emptyProjects');

  if (!list.length) {
    tbody.innerHTML = '';
    empty.classList.remove('hidden');
  } else {
    empty.classList.add('hidden');
    tbody.innerHTML = list.map(p => projectTableRowHtml(p)).join('');
  }
  lucide.createIcons();
}

