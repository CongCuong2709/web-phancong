function closeProjectModal() {
  const modal = document.getElementById('projectModal');
  modal.classList.add('hidden');
  modal.classList.remove('flex');
}

function handleSaveProject(e) {
  e.preventDefault();
  const id = document.getElementById('projectId').value;
  const data = {
    code: document.getElementById('fCode').value.trim(),
    name: document.getElementById('fName').value.trim(),
    description: document.getElementById('fDescription').value.trim(),
    department: document.getElementById('fDept').value,
    assignee: document.getElementById('fAssignee').value.trim(),
    startDate: document.getElementById('fStartDate').value,
    endDate: document.getElementById('fEndDate').value,
    priority: document.getElementById('fPriority').value,
    progress: Number(document.getElementById('fProgress').value || 0),
    results: document.getElementById('fResults').value.trim(),
    status: document.getElementById('fStatus').value,
    notes: '',
  };

  if (!data.code || !data.name || !data.assignee) {
    showToast('Vui lòng nhập đầy đủ Mã dự án, Tên dự án và Người thực hiện', true);
    return;
  }

  if (id) {
    const p = projects.find(x => x.id === id);
    if (p) Object.assign(p, data);
    showToast('Đã cập nhật dự án');
  } else {
    const newProject = {
      id: uid(),
      ...data,
      createdBy: `${currentUser.name} (${currentUser.department})`,
      history: [
        { at: new Date().toISOString(), action: 'Tạo dự án', user: currentUser.name }
      ],
    };
    projects.unshift(newProject);
    showToast('Đã tạo dự án mới');
  }

  saveProjects();
  closeProjectModal();
  navigateTo(currentView);
}

function confirmDelete(id) {
  const p = projects.find(x => x.id === id);
  if (!p) return;
  if (!confirm(`Xóa dự án "${p.code} - ${p.name}"?\nHành động này không thể hoàn tác.`)) return;
  projects = projects.filter(x => x.id !== id);
  saveProjects();
  showToast('Đã xóa dự án');
  navigateTo(currentView);
}

