function openProjectModal(id) {
  const modal = document.getElementById('projectModal');
  const form = document.getElementById('projectForm');
  form.reset();
  document.getElementById('projectId').value = '';

  if (id) {
    const p = projects.find(x => x.id === id);
    if (!p) return;
    document.getElementById('projectModalTitle').textContent = 'Sửa dự án';
    document.getElementById('fCode').value = p.code || '';
    document.getElementById('fName').value = p.name || '';
    document.getElementById('fDescription').value = p.description || '';
    document.getElementById('fDept').value = p.department || 'Phòng IT';
    document.getElementById('fAssignee').value = p.assignee || '';
    document.getElementById('fStartDate').value = p.startDate || '';
    document.getElementById('fEndDate').value = p.endDate || '';
    document.getElementById('fPriority').value = p.priority || 'medium';
    document.getElementById('fProgress').value = p.progress || 0;
    document.getElementById('fResults').value = p.results || '';
    document.getElementById('fStatus').value = p.status || 'not_started';
