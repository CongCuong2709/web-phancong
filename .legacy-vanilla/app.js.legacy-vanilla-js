// ===== My Tasks =====
function renderMyTasks() {
  const list = getVisibleProjects()
    .filter(p => p.status !== 'completed')
    .sort((a, b) => {
      // Sắp xếp: quá hạn -> cao -> trung bình -> thấp; sau đó theo hạn
      const aOverdue = isOverdue(a) ? 1 : 0;
      const bOverdue = isOverdue(b) ? 1 : 0;
      if (aOverdue !== bOverdue) return bOverdue - aOverdue;
      const order = { high: 0, medium: 1, low: 2 };
      if (order[a.priority] !== order[b.priority]) return order[a.priority] - order[b.priority];
      return new Date(a.endDate || 0) - new Date(b.endDate || 0);
    });

  const el = document.getElementById('myTasksList');
  const empty = document.getElementById('emptyMyTasks');

  if (!list.length) {
    el.innerHTML = '';
    empty.classList.remove('hidden');
  } else {
    empty.classList.add('hidden');
    el.innerHTML = list.map(p => myTaskCardHtml(p)).join('');
  }
  lucide.createIcons();
}

