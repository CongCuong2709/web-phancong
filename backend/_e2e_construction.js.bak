// E2E test cho 4-tier model
const http = require('http');

function req(method, path, token, body) {
  return new Promise((resolve, reject) => {
    const data = body ? JSON.stringify(body) : null;
    const opts = {
      hostname: 'localhost', port: 3000, path, method,
      headers: {
        'Content-Type': 'application/json',
        ...(data ? { 'Content-Length': Buffer.byteLength(data) } : {}),
        ...(token ? { Authorization: 'Bearer ' + token } : {}),
      },
    };
    const r = http.request(opts, (res) => {
      let buf = '';
      res.on('data', (c) => (buf += c));
      res.on('end', () => {
        try { resolve({ status: res.statusCode, body: buf ? JSON.parse(buf) : {} }); }
        catch { resolve({ status: res.statusCode, body: { raw: buf } }); }
      });
    });
    r.on('error', reject);
    if (data) r.write(data);
    r.end();
  });
}

async function login(username, password = '123456') {
  const r = await req('POST', '/api/auth/login', null, { username, password });
  if (r.status !== 200) throw new Error(`Login ${username} failed: ${r.status} ${JSON.stringify(r.body)}`);
  return r.body.token;
}

async function main() {
  let pass = 0, fail = 0;
  const check = (label, cond, detail = '') => {
    if (cond) { console.log(`✓ ${label}`); pass++; }
    else { console.log(`✗ ${label} ${detail}`); fail++; }
  };

  console.log('\n=== 1. Login ===');
  const adminTok = await login('admin', 'admin123');
  const bgdTok = await login('bgd.tienanh');
  const tpQldaTok = await login('tp.qlda');
  const tpKttkTok = await login('tp.kttk');
  const tpKttcTok = await login('tp.kttc');
  check('Login admin', !!adminTok);
  check('Login BGĐ', !!bgdTok);
  check('Login TP.QLDA', !!tpQldaTok);
  check('Login TP.KTTK', !!tpKttkTok);
  check('Login TP.KTTC', !!tpKttcTok);

  console.log('\n=== 2. List projects (BGĐ) ===');
  const listRes = await req('GET', '/api/projects', bgdTok);
  check(`BGĐ thấy ${listRes.body.length} dự án (expect ≥ 3)`, listRes.body.length >= 3, JSON.stringify(listRes.body).slice(0, 100));
  const projA = listRes.body.find((p) => p.code === 'DA-KĐT-X');
  check('Có project DA-KĐT-X', !!projA);
  console.log('   Stats DA-KĐT-X:', JSON.stringify(projA.stats));

  console.log('\n=== 3. Project detail (kèm phases + bundles) ===');
  const detailRes = await req('GET', `/api/projects/${projA.id}`, bgdTok);
  check('DA-KĐT-X có 4 phases', detailRes.body.phases?.length === 4, `got ${detailRes.body.phases?.length}`);
  check('Phase 1 là "Chuẩn bị đầu tư"', detailRes.body.phases?.[0]?.name === 'Chuẩn bị đầu tư');
  check('DA-KĐT-X có 5 bundles', detailRes.body.bundles?.length === 5, `got ${detailRes.body.bundles?.length}`);
  const bundle1 = detailRes.body.bundles?.[0];
  check('Bundle đầu có owner là TP', !!bundle1?.owner);

  console.log('\n=== 4. Project dashboard ===');
  const dashRes = await req('GET', `/api/projects/${projA.id}/dashboard`, bgdTok);
  check('Dashboard có phases', dashRes.body.phases?.length >= 1);
  check('Dashboard có summary.bottlenecks', Array.isArray(dashRes.body.summary?.bottlenecks));
  check('Dashboard có summary.upcomingDeadlines', Array.isArray(dashRes.body.summary?.upcomingDeadlines));
  console.log('   Overall progress:', dashRes.body.summary?.overallProgress);

  console.log('\n=== 5. TP chỉ thấy project có bundle phòng mình ===');
  const tpList = await req('GET', '/api/projects', tpQldaTok);
  // DA-KĐT-X + DA-SVD-Z đều có bundle QLDA → TP.QLDA thấy 2
  check(`TP.QLDA thấy ${tpList.body.length} dự án (expect = 2)`, tpList.body.length === 2, `got ${tpList.body.length}`);
  const codes = tpList.body.map((p) => p.code).sort();
  check('Thấy DA-KĐT-X', codes.includes('DA-KĐT-X'));
  check('Thấy DA-SVD-Z', codes.includes('DA-SVD-Z'));

  console.log('\n=== 6. TP.QLDA xem project khác (DA-THPT-Y) ===');
  const otherProj = listRes.body.find((p) => p.code === 'DA-THPT-Y');
  const otherAccess = await req('GET', `/api/projects/${otherProj.id}`, tpQldaTok);
  check('TP.QLDA bị chặn xem DA-THPT-Y (403)', otherAccess.status === 403, `got ${otherAccess.status}`);

  console.log('\n=== 7. Tạo bundle mới (BGĐ) ===');
  const newBundle = await req('POST', `/api/projects/${projA.id}/bundles`, bgdTok, {
    name: 'Khảo sát mặt bằng bổ sung',
    department: 'QLDA',
    startDate: new Date().toISOString().slice(0, 10),
    dueDate: new Date(Date.now() + 14 * 86400000).toISOString().slice(0, 10),
    priority: 'medium',
    description: 'Test bundle mới tạo',
  });
  check(`POST bundle returns 201`, newBundle.status === 201, `got ${newBundle.status}: ${JSON.stringify(newBundle.body)}`);
  check('Bundle có owner tự fill (TP.QLDA)', newBundle.body.owner?.username === 'tp.qlda', `got ${newBundle.body.owner?.username}`);
  check('Bundle code = DAxxx', /^DA\d{3}$/.test(newBundle.body.code), `got ${newBundle.body.code}`);

  console.log('\n=== 8. Auto-fill owner: BGĐ tạo bundle cho KTTC ===');
  const kttcBundle = await req('POST', `/api/projects/${projA.id}/bundles`, bgdTok, {
    name: 'Test bundle KTTC',
    department: 'KTTC',
  });
  check('POST KTTC bundle returns 201', kttcBundle.status === 201, `got ${kttcBundle.status}`);
  check('Owner tự fill = TP.KTTC', kttcBundle.body.owner?.username === 'tp.kttc', `got ${kttcBundle.body.owner?.username}`);

  console.log('\n=== 9. Đổi dept (auto đổi owner) ===');
  const changeDept = await req('PATCH', `/api/bundles/${kttcBundle.body.id}/department`, bgdTok, {
    department: 'KTTK',
  });
  check('PATCH dept returns 200', changeDept.status === 200, `got ${changeDept.status}: ${JSON.stringify(changeDept.body)}`);
  check('Owner đổi thành TP.KTTK', changeDept.body.owner?.username === 'tp.kttk', `got ${changeDept.body.owner?.username}`);
  check('Department đổi thành KTTK', changeDept.body.department === 'KTTK');
  check('Response có prevOwnerId', !!changeDept.body.prevOwnerId);

  console.log('\n=== 10. Đổi owner thủ công (cùng dept) ===');
  const tpItExists = await login('tp.it').catch(() => null);
  if (tpItExists) {
    const reassign = await req('PATCH', `/api/bundles/${kttcBundle.body.id}/owner`, bgdTok, {
      ownerId: 'INVALI_ID',
    });
    check('PATCH owner với invalid id → 400', reassign.status === 400, `got ${reassign.status}`);
  }

  console.log('\n=== 11. Bundle state machine ===');
  // Start bundle
  const startRes = await req('POST', `/api/bundles/${newBundle.body.id}/start`, tpQldaTok);
  check('TP.QLDA start bundle (assigned → in_progress)', startRes.status === 200, `got ${startRes.status}`);
  check('Status = in_progress', startRes.body.status === 'in_progress');
  // Block with reason
  const blockRes = await req('POST', `/api/bundles/${newBundle.body.id}/block`, tpQldaTok, {
    reason: 'Chờ phê duyệt BGĐ',
  });
  check('Block returns 200', blockRes.status === 200);
  check('Status = blocked', blockRes.body.status === 'blocked');
  check('block_reason saved', blockRes.body.blockReason === 'Chờ phê duyệt BGĐ');
  // Resume
  const resumeRes = await req('POST', `/api/bundles/${newBundle.body.id}/resume`, tpQldaTok);
  check('Resume returns 200', resumeRes.status === 200);
  check('Status = in_progress', resumeRes.body.status === 'in_progress');
  check('block_reason cleared', !resumeRes.body.blockReason);

  console.log('\n=== 12. Tạo task trong bundle + rollup progress ===');
  const nvQlda1 = listRes.body; // dummy
  // Lấy NV.QLDA.1
  const usersRes = await req('GET', '/api/users', adminTok);
  const nv1 = usersRes.body.find((u) => u.username === 'nv.qlda1');
  const task1 = await req('POST', `/api/bundles/${newBundle.body.id}/tasks`, tpQldaTok, {
    name: 'Đo đạc chi tiết khu đất',
    assigneeId: nv1.id,
    startDate: new Date().toISOString().slice(0, 10),
    endDate: new Date(Date.now() + 7 * 86400000).toISOString().slice(0, 10),
    priority: 'high',
  });
  check('Create task returns 201', task1.status === 201, `got ${task1.status}`);
  check('Task có bundle_id', task1.body.bundle_id === newBundle.body.id);

  // Wait 0.5s for rollup
  await new Promise((r) => setTimeout(r, 200));
  const bundleAfterTask = await req('GET', `/api/bundles/${newBundle.body.id}`, bgdTok);
  check('Bundle có 1 task', bundleAfterTask.body.tasks?.length === 1);

  console.log('\n=== 13. Tạo task độc lập (không bundle) ===');
  const nvHcns1 = usersRes.body.find((u) => u.username === 'nv.hcns1');
  const standalone = await req('POST', `/api/projects/${projA.id}/tasks`, bgdTok, {
    name: 'Yêu cầu phát sinh: kiểm tra hợp đồng NCC',
    assigneeId: nvHcns1.id,
    startDate: new Date().toISOString().slice(0, 10),
    endDate: new Date(Date.now() + 3 * 86400000).toISOString().slice(0, 10),
    priority: 'high',
  });
  check('Standalone task returns 201', standalone.status === 201, `got ${standalone.status}: ${JSON.stringify(standalone.body)}`);
  check('Standalone task có project_id', standalone.body.project_id === projA.id);
  check('Standalone task có bundle_id = null', !standalone.body.bundle_id);

  console.log('\n=== 14. Permission: NV không tạo task ===');
  const nvTok = await login(nv1.username);
  const nvTry = await req('POST', `/api/projects/${projA.id}/tasks`, nvTok, {
    name: 'NV cố tạo task',
    assigneeId: nv1.id,
  }).catch((e) => ({ status: 500, body: { error: e.message } }));
  check('NV bị 403 khi tạo task', nvTry.status === 403, `got ${nvTry.status}: ${JSON.stringify(nvTry.body)}`);

  console.log('\n=== 15. Đổi dept → owner cùng phòng ===');
  const changeDept2 = await req('PATCH', `/api/bundles/${newBundle.body.id}/department`, bgdTok, {
    department: 'IT',
  });
  check('Đổi dept → IT returns 200', changeDept2.status === 200, `got ${changeDept2.status}`);
  check('Owner tự fill = TP.IT', changeDept2.body.owner?.username === 'tp.it', `got ${changeDept2.body.owner?.username}`);

  console.log('\n=== 16. Reopen (admin) ===');
  // Close a bundle trước
  const closeBundle = await req('GET', `/api/bundles/${bundle1.id}`, bgdTok);
  // bundle1 status = completed (đã tạo ở seed với progress=100)
  // Nếu chưa completed thì skip test close
  if (closeBundle.body.status === 'completed') {
    const close = await req('POST', `/api/bundles/${bundle1.id}/close`, bgdTok);
    check('Close returns 200', close.status === 200);
    const reopen = await req('POST', `/api/bundles/${bundle1.id}/reopen`, adminTok, {
      reason: 'Test reopen',
    });
    check('Reopen returns 200', reopen.status === 200, `got ${reopen.status}: ${JSON.stringify(reopen.body)}`);
    check('Status = assigned sau reopen', reopen.body.status === 'assigned');
  } else {
    console.log(`   ⏭ Skip close/reopen test (status = ${closeBundle.body.status})`);
  }

  console.log(`\n${pass} pass / ${fail} fail`);
  process.exit(fail > 0 ? 1 : 0);
}

main().catch((e) => { console.error('FATAL', e); process.exit(2); });
