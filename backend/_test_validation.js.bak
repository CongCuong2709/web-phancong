// E2E test for assignment validation
// Login BGĐ + TP, then POST tasks với các assignee khác nhau, kiểm tra status code.

const http = require('http');

function req(method, path, token, body) {
  return new Promise((resolve, reject) => {
    const data = body ? JSON.stringify(body) : null;
    const opts = {
      hostname: 'localhost',
      port: 3000,
      path,
      method,
      headers: {
        'Content-Type': 'application/json',
        ...(data ? { 'Content-Length': Buffer.byteLength(data) } : {}),
        ...(token ? { Authorization: 'Bearer ' + token } : {}),
      },
    };
    const r = http.request(opts, (res) => {
      let buf = '';
      res.on('data', (c) => (buf += c));
      res.on('end', () => {
        try {
          resolve({ status: res.statusCode, body: buf ? JSON.parse(buf) : {} });
        } catch {
          resolve({ status: res.statusCode, body: { raw: buf } });
        }
      });
    });
    r.on('error', reject);
    if (data) r.write(data);
    r.end();
  });
}

async function login(username) {
  const r = await req('POST', '/api/auth/login', null, { username, password: '123456' });
  if (r.status !== 200) throw new Error(`Login ${username} failed: ${r.status} ${JSON.stringify(r.body)}`);
  return r.body.token;
}

async function main() {
  const ids = {
    dir:      '0bb73a28-af6a-4b39-8048-3dda257b00d3', // BGĐ Cường
    otherDir: '9b5c2162-ef83-413f-a702-025144b25da8', // BGĐ Tiến Anh
    mgr:      '8bba632c-0f7f-4500-a565-bbc7e4801db8', // TP Kế toán
    empKToan: '22216401-7c5e-4000-bd22-1b3e148ac701', // NV Kế toán (giả định)
    empHCNS:  '5022aa18-ba65-4998-ba58-1b3e148ac701', // NV HCNS (giả định)
  };

  // Lấy 1 NV Kế toán & 1 NV HCNS thực tế từ DB
  const db = require('./db');
  const empKToan = db.prepare("SELECT id FROM users WHERE role='employee' AND department='Kế toán' AND active=1 LIMIT 1").get();
  const empHCNS  = db.prepare("SELECT id FROM users WHERE role='employee' AND department='HCNS' AND active=1 LIMIT 1").get();
  if (empKToan) ids.empKToan = empKToan.id;
  if (empHCNS)  ids.empHCNS  = empHCNS.id;
  console.log('Resolved ids:', ids, '\n');

  const bgdTok = await login('tag.dndung@gmail.com');
  const tpTok  = await login('caocuong17479@gmail.com');

  const tests = [
    // BGĐ rules
    { label: 'BGĐ → NV',                       token: bgdTok, assignee: ids.empHCNS,  dept: 'HCNS',   expect: 201 },
    { label: 'BGĐ → TP',                       token: bgdTok, assignee: ids.mgr,      dept: 'Kế toán',expect: 201 },
    { label: 'BGĐ → BGĐ khác',                  token: bgdTok, assignee: ids.otherDir, dept: 'Ban Giám đốc', expect: 403 },

    // TP rules
    { label: 'TP → NV thuộc phòng mình',        token: tpTok,  assignee: ids.empKToan, dept: 'Kế toán',expect: 201 },
    { label: 'TP → NV ngoài phòng',             token: tpTok,  assignee: ids.empHCNS,  dept: 'HCNS',   expect: 403 },
    { label: 'TP → TP khác',                    token: tpTok,  assignee: ids.mgr,      dept: 'HCNS',   expect: 403 },
    { label: 'TP → BGĐ',                        token: tpTok,  assignee: ids.otherDir, dept: 'Ban Giám đốc', expect: 403 },
  ];

  let pass = 0, fail = 0;
  for (const t of tests) {
    const r = await req('POST', '/api/tasks', t.token, {
      name: `TEST - ${t.label}`,
      department: t.dept,
      assigneeId: t.assignee,
      priority: 'low',
      status: 'not_started',
    });
    const ok = r.status === t.expect;
    console.log(
      `${ok ? '✓' : '✗'} [${t.label}] expected=${t.expect} got=${r.status}` +
      (ok ? '' : ` body=${JSON.stringify(r.body).slice(0, 120)}`),
    );
    if (ok) pass++; else fail++;
  }
  console.log(`\n${pass} pass / ${fail} fail`);
  process.exit(fail > 0 ? 1 : 0);
}

main().catch((e) => { console.error('FATAL', e); process.exit(2); });
