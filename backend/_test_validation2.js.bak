// Test PUT /tasks/:id + POST /tasks/:id/subtasks (re-assignment sau khi tạo)
const http = require('http');
const db = require('./db');

function req(method, path, token, body) {
  return new Promise((resolve, reject) => {
    const data = body ? JSON.stringify(body) : null;
    const opts = {
      hostname: 'localhost', port: 3000, path, method,
      headers: {
        'Content-Type': 'application/json',
        ...(data ? { 'Content-Length': Buffer.byteLength(data) } : {}),
        ...(token ? { Authorization: 'Bearer ' + token } : {}),
      },
    };
    const r = http.request(opts, (res) => {
      let buf = '';
      res.on('data', (c) => (buf += c));
      res.on('end', () => {
        try { resolve({ status: res.statusCode, body: buf ? JSON.parse(buf) : {} }); }
        catch { resolve({ status: res.statusCode, body: { raw: buf } }); }
      });
    });
    r.on('error', reject);
    if (data) r.write(data);
    r.end();
  });
}

async function login(username) {
  const r = await req('POST', '/api/auth/login', null, { username, password: '123456' });
  return r.body.token;
}

async function main() {
  const bgdTok = await login('tag.dndung@gmail.com');
  const tpTok  = await login('caocuong17479@gmail.com');

  const empKToan = db.prepare("SELECT id FROM users WHERE role='employee' AND department='Kế toán' AND active=1 LIMIT 1").get().id;
  const empHCNS  = db.prepare("SELECT id FROM users WHERE role='employee' AND department='HCNS' AND active=1 LIMIT 1").get().id;
  const mgrHCNS  = db.prepare("SELECT id FROM users WHERE role='manager' AND department='HCNS' AND active=1 LIMIT 1").get().id;
  const dirOther = db.prepare("SELECT id FROM users WHERE role='director' AND active=1 ORDER BY fullname LIMIT 1").get().id;

  // Tạo task mới để test
  const create = await req('POST', '/api/tasks', tpTok, {
    name: 'Test re-assign',
    department: 'Kế toán',
    assigneeId: empKToan,
    priority: 'low',
    status: 'not_started',
  });
  if (create.status !== 201) {
    console.error('Cannot create test task:', create);
    process.exit(2);
  }
  const taskId = create.body.id;
  console.log('Created task', taskId, 'as TP Kế toán\n');

  const tests = [
    // PUT /tasks/:id - re-assign
    { label: 'PUT: TP reassign NV→NV ngoài phòng', endpoint: 'put', assignee: empHCNS, expect: 403 },
    { label: 'PUT: TP reassign NV→TP khác',        endpoint: 'put', assignee: mgrHCNS, expect: 403 },
    { label: 'PUT: TP reassign NV→BGĐ',            endpoint: 'put', assignee: dirOther, expect: 403 },
    { label: 'PUT: TP reassign NV→NV cùng phòng',  endpoint: 'put', assignee: empKToan, expect: 200 },

    // POST /tasks/:id/subtasks
    { label: 'SUB: TP add subtask cho NV ngoài phòng', endpoint: 'sub', assignee: empHCNS, expect: 403 },
    { label: 'SUB: TP add subtask cho TP khác',         endpoint: 'sub', assignee: mgrHCNS, expect: 403 },
    { label: 'SUB: TP add subtask cho BGĐ',             endpoint: 'sub', assignee: dirOther, expect: 403 },
    { label: 'SUB: TP add subtask cho NV cùng phòng',   endpoint: 'sub', assignee: empKToan, expect: 201 },
  ];

  let pass = 0, fail = 0;
  for (const t of tests) {
    let r;
    if (t.endpoint === 'put') {
      r = await req('PUT', '/api/tasks/' + taskId, tpTok, {
        assigneeId: t.assignee,
      });
    } else {
      r = await req('POST', `/api/tasks/${taskId}/subtasks`, tpTok, {
        name: `Sub test - ${t.label}`,
        assigneeId: t.assignee,
        priority: 'low',
        status: 'not_started',
      });
    }
    const ok = r.status === t.expect;
    console.log(`${ok ? '✓' : '✗'} [${t.label}] expect=${t.expect} got=${r.status}` +
      (ok ? '' : ` body=${JSON.stringify(r.body).slice(0, 120)}`));
    if (ok) pass++; else fail++;
  }
  console.log(`\n${pass} pass / ${fail} fail`);
  process.exit(fail > 0 ? 1 : 0);
}

main().catch((e) => { console.error('FATAL', e); process.exit(2); });
